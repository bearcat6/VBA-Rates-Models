
Option Explicit

'====================================================
' Class: CCapVolTermStructure
' Purpose:
'   Stores bootstrapped caplet normal volatility term structure
'====================================================

Private mValDate As Date

Private mPeriodStartDates() As Date
Private mPeriodEndDates() As Date
Private mNormalVols() As Double
Private mCount As Long

Public Sub Init(ByVal ValuationDate As Date)
    mValDate = ValuationDate
    mCount = 0
End Sub

Public Property Get ValuationDate() As Date
    ValuationDate = mValDate
End Property

Public Property Get Count() As Long
    Count = mCount
End Property

Public Sub AddCapletVol( _
    ByVal periodStartDate As Date, _
    ByVal periodEndDate As Date, _
    ByVal normalVol As Double _
)

    mCount = mCount + 1

    ReDim Preserve mPeriodStartDates(1 To mCount)
    ReDim Preserve mPeriodEndDates(1 To mCount)
    ReDim Preserve mNormalVols(1 To mCount)

    mPeriodStartDates(mCount) = periodStartDate
    mPeriodEndDates(mCount) = periodEndDate
    mNormalVols(mCount) = normalVol

End Sub

Public Function GetNormalVolByPeriodEnd( _
    ByVal periodEndDate As Date _
) As Double

    Dim i As Long

    For i = 1 To mCount
        If mPeriodEndDates(i) = periodEndDate Then
            GetNormalVolByPeriodEnd = mNormalVols(i)
            Exit Function
        End If
    Next i

    Err.Raise vbObjectError + 1001, , _
        "No caplet volatility found for period end date: " & CStr(periodEndDate)

End Function

Public Function GetNormalVolByFixingDate( _
    ByVal fixingDate As Date _
) As Double

    Dim i As Long

    For i = 1 To mCount
        If fixingDate > mPeriodStartDates(i) _
           And fixingDate <= mPeriodEndDates(i) Then

            GetNormalVolByFixingDate = mNormalVols(i)
            Exit Function

        End If
    Next i

    Err.Raise vbObjectError + 1002, , _
        "No caplet volatility found for fixing date: " & CStr(fixingDate)

End Function

Public Function GetNormalVolByIndex(ByVal index As Long) As Double
    If index < 1 Or index > mCount Then
        Err.Raise vbObjectError + 1003, , "Index out of range."
    End If

    GetNormalVolByIndex = mNormalVols(index)
End Function

Public Function GetPeriodStartDate(ByVal index As Long) As Date
    If index < 1 Or index > mCount Then
        Err.Raise vbObjectError + 1004, , "Index out of range."
    End If

    GetPeriodStartDate = mPeriodStartDates(index)
End Function

Public Function GetPeriodEndDate(ByVal index As Long) As Date
    If index < 1 Or index > mCount Then
        Err.Raise vbObjectError + 1005, , "Index out of range."
    End If

    GetPeriodEndDate = mPeriodEndDates(index)
End Function

Public Function TotalVarianceToDate( _
    ByVal targetDate As Date _
) As Double

    Dim i As Long
    Dim t0 As Double
    Dim t1 As Double
    Dim v As Double

    v = 0#

    For i = 1 To mCount

        If mPeriodStartDates(i) >= targetDate Then
            Exit For
        End If

        t0 = YearFrac_ACT365(mValDate, mPeriodStartDates(i))
        t1 = YearFrac_ACT365(mValDate, mPeriodEndDates(i))

        If mPeriodEndDates(i) > targetDate Then
            t1 = YearFrac_ACT365(mValDate, targetDate)
        End If

        If t1 > t0 Then
            v = v + mNormalVols(i) * mNormalVols(i) * (t1 - t0)
        End If

        If mPeriodEndDates(i) >= targetDate Then
            Exit For
        End If

    Next i

    TotalVarianceToDate = v

End Function

Public Function DumpToSheet( _
    ByVal sheetName As String, _
    Optional ByVal startCell As String = "A1" _
)

    Dim ws As Worksheet
    Dim r As Long
    Dim i As Long

    Set ws = ThisWorkbook.Worksheets(sheetName)

    r = ws.Range(startCell).Row

    ws.Cells(r, ws.Range(startCell).Column).Value = "No"
    ws.Cells(r, ws.Range(startCell).Column + 1).Value = "Start"
    ws.Cells(r, ws.Range(startCell).Column + 2).Value = "End"
    ws.Cells(r, ws.Range(startCell).Column + 3).Value = "Normal Vol"
    ws.Cells(r, ws.Range(startCell).Column + 4).Value = "Normal Vol(bp)"

    For i = 1 To mCount
        ws.Cells(r + i, ws.Range(startCell).Column).Value = i
        ws.Cells(r + i, ws.Range(startCell).Column + 1).Value = mPeriodStartDates(i)
        ws.Cells(r + i, ws.Range(startCell).Column + 2).Value = mPeriodEndDates(i)
        ws.Cells(r + i, ws.Range(startCell).Column + 3).Value = mNormalVols(i)
        ws.Cells(r + i, ws.Range(startCell).Column + 4).Value = mNormalVols(i) * 10000#
    Next i

End Function

